# Copie para .env e preencha. Não commite o .env.
POSTGRES_USER=docfactory
POSTGRES_PASSWORD=
POSTGRES_DB=docfactory
API_PORT=8000
CONF_AUTO=0.85
CONF_MIN=0.50
# Classificador: jev (Jev + Gemini) ou regras (sem rede)
CLASSIFICADOR=jev
OPENROUTER_API_KEY=
JEV_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ANALISE_MODEL=gemini-3.5-flash
# CORS: origens do frontend separadas por virgula (padrao: dev server do Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Autenticacao. O login usa a tabela de usuarios. AUTH_USUARIO e AUTH_SENHA servem so para criar o primeiro
# administrador (na subida do servico migrate); trocar AUTH_SENHA depois nao muda a senha de quem ja existe.
# Sem AUTH_SEGREDO o login responde 503 e a API recusa tudo.
# Gerar um segredo: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_USUARIO=
AUTH_SENHA=
AUTH_SEGREDO=
# Validade do token em minutos
AUTH_EXPIRA_MIN=480
# Validade do link de convite (uso unico), em dias
CONVITE_VALIDADE_DIAS=7
